RewriteEngine On

# ----------------------------------------------------------------------
# 1. External redirect from /file.php to /file (clean URL in browser)
#    Only applied to GET requests so POST forms will never lose data
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_METHOD} !POST [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# ----------------------------------------------------------------------
# 2. Internally route clean URL /file to /file.php if the file exists
# ----------------------------------------------------------------------
# Do not rewrite if the request is an actual directory (e.g. /login/)
RewriteCond %{REQUEST_FILENAME} !-d
# Only rewrite if adding .php matches an existing physical file
RewriteCond %{REQUEST_FILENAME}\.php -f
# Internally rewrite to .php and preserve query string parameters (?id=1)
RewriteRule ^(.*)$ $1.php [L,QSA]

